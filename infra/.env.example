# Production settings. Copy to infra/.env on the server (bootstrap.sh does
# this and generates DB_PASSWORD). infra/.env is gitignored.

API_DOMAIN=api.tandemcode.space

DB_NAME=tandemcode
DB_USER=tandemcode
DB_PASSWORD=
# Postgres superuser, for maintenance only; the app never uses it. Both
# passwords take effect only when the database volume is first created.
DB_ADMIN_PASSWORD=

# The web app's origins. Clerk tokens minted for any other origin are refused.
CORS_ORIGINS=https://tandemcode.space,https://www.tandemcode.space

# Clerk production instance: Dashboard -> API keys. The issuer is the
# Frontend API URL, e.g. https://clerk.tandemcode.space
CLERK_ISSUER=
CLERK_SECRET_KEY=
