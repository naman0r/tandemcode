# Template. Copy to .env and fill in a real password:
#   cp .env.example .env
# .env is gitignored; this file is committed and must never hold real secrets.
#
# docker-compose.yml reads these same variables, so one file configures both
# the database container and the app.

DB_HOST=localhost
DB_PORT=5433
DB_NAME=tandemcode_dev
DB_USER=tandemcode
DB_PASSWORD=

CORS_ORIGINS=http://localhost:5173
RUN_MIGRATIONS_ON_STARTUP=true
