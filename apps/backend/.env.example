# Template. Copy to .env and fill in a real password:
#   cp .env.example .env
# .env is gitignored; this file is committed and must never hold real secrets.
#
# docker-compose.yml reads these same variables, so one file configures both
# the database container and the app.

DB_HOST=localhost
DB_PORT=5433
DB_NAME=tandemcode_dev
DB_USER=tandemcode
DB_PASSWORD=

CORS_ORIGINS=http://localhost:5173

# Clerk instance that signs session tokens. Find it in the Clerk dashboard
# under API Keys as the Frontend API URL. Not a secret.
CLERK_ISSUER=https://your-app.clerk.accounts.dev

# Clerk dashboard -> API Keys -> Secret key. Used to read user profiles so
# that email and name never come from the client. This one IS a secret.
CLERK_SECRET_KEY=

RUN_MIGRATIONS_ON_STARTUP=true

# Only for `docker compose --profile prod up`, which builds the web app too.
# Clerk dashboard -> API Keys -> Publishable key. Not a secret.
VITE_CLERK_PUBLISHABLE_KEY=
# Where browsers reach the API. Baked into the web build.
VITE_BACKEND_URL=http://localhost:8080
