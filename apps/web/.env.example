# Template. Copy to .env and fill in the key:
#   cp .env.example .env
# .env is gitignored. Both values end up in the browser bundle, so neither is
# a secret.

# Clerk dashboard -> API keys -> Publishable key.
VITE_CLERK_PUBLISHABLE_KEY=

# Where the browser reaches the API. Websocket URLs are derived from it.
VITE_BACKEND_URL=http://localhost:8080
